# Copy to .env. Never commit .env.
# This PC's LAN address as the Pi sees it (the orchestrator calls the worker back here).
FFFLEET_ADVERTISE_URL=http://10.0.0.50:5100
# Orchestrator on the Pi (wired address 10.0.0.78 once set).
FFFLEET_ORCHESTRATOR_URL=http://10.0.0.78:5000
FFFLEET_WORKER_TOKEN=change-me
FFFLEET_WORKER_ID=operator-pc
FFFLEET_CAPABILITIES=normal,dsk,gpu,nvenc,desktop,host:operator-pc
FFFLEET_SLOTS=stream=8,default=4
FFFLEET_PRIORITY=2
# piperception detection worker (detect-worker): own fffleet worker ID and port on this PC.
FFFLEET_DETECT_ADVERTISE_URL=http://10.0.0.50:5101
#FFFLEET_DETECT_WORKER_PORT=5101
#FFFLEET_DETECT_WORKER_ID=operator-pc-detect
# The Pi's MediaMTX RTSP address as this PC reaches it (host:port).
MEDIAMTX_RTSP_HOSTPORT=pi-host:8554
#PERCEPTION_ORT_THREADS=4
AUDITOR_STT_API_KEY=change-me
# AUDITOR_STT_DEVICE=cpu
# AUDITOR_STT_MODEL=large-v3-turbo
# S3 for s3:// job inputs/outputs (empty = off)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FFFLEET_S3_ENDPOINT=
# FFFLEET_S3_PATH_STYLE=1

# VersityGW (S3 for pistorage). Choose your own keys; they go into pistorage PISTORAGE_S3_ACCESS_KEY / _SECRET_KEY.
VERSITYGW_ACCESS_KEY=change-me
VERSITYGW_SECRET_KEY=change-me-too
#VERSITYGW_HOST_PORT=7070
#PISTORAGE_BUCKET=pistorage
