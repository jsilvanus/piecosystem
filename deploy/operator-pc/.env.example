# Copy to .env. Never commit .env.
# This PC's LAN address as the Pi sees it (the orchestrator calls the worker back here).
FFFLEET_ADVERTISE_URL=http://192.168.1.50:5100
# Orchestrator on kirkonpi (wired address 192.168.1.78 once set).
FFFLEET_ORCHESTRATOR_URL=http://192.168.1.78:5000
FFFLEET_WORKER_TOKEN=change-me
FFFLEET_WORKER_ID=operator-pc
FFFLEET_CAPABILITIES=host:operator-pc,tier:2
FFFLEET_PRIORITY=2
AUDITOR_STT_API_KEY=change-me
# AUDITOR_STT_DEVICE=cpu
# AUDITOR_STT_MODEL=large-v3-turbo
# S3 for s3:// job inputs/outputs (empty = off)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# FFFLEET_S3_ENDPOINT=
# FFFLEET_S3_PATH_STYLE=1
