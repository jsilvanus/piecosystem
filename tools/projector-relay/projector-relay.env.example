# Copy to /home/pi/apps/projector-relay.env (mode 600). Never commit the real file.
PROJECTOR_PIN=
# Helsinki is UTC+2 on 2026-11-03: 06:00 local = 04:00Z
PROJECTOR_EXPIRES_AT=2026-11-03T04:00:00Z
PIGATEWAY_URL=http://127.0.0.1:3000
PIGATEWAY_API_KEY=
HOST=127.0.0.1
PORT=3180
# Set to 1 only when a trusted reverse proxy appends X-Forwarded-For (rate limit per client address)
TRUST_PROXY=1
