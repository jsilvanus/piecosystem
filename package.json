{
  "name": "piecosystem",
  "version": "1.0.0",
  "description": "System architecture, cross-project planning, and developer coordination for the Raspberry Pi production ecosystem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/generate-ecosystem.mjs",
    "health": "node scripts/ecosystem-health.mjs",
    "status": "node scripts/ecosystem-status.mjs",
    "status:ps": "powershell -ExecutionPolicy Bypass -File scripts/ecosystem-status.ps1",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
